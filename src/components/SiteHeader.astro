---
import BrandGithub from "@tabler/icons/outline/brand-github.svg";
import BrandLinkedin from "@tabler/icons/outline/brand-linkedin.svg";
import Menu2 from "@tabler/icons/outline/menu-2.svg";
import Rss from "@tabler/icons/outline/rss.svg";
import { Button } from "@/components/starwind/button";
import { Separator } from "@/components/starwind/separator";
import {
  Sheet,
  SheetContent,
  SheetDescription,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from "@/components/starwind/sheet";
import { ThemeToggle } from "@/components/starwind/theme-toggle";
import site from "@/data/site.json";

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isCurrentRoute(url: string): boolean {
  const normalizedTarget = url.replace(/\/+$/, "") || "/";
  if (normalizedTarget === "/") {
    return currentPath === "/";
  }
  return currentPath === normalizedTarget || currentPath.startsWith(`${normalizedTarget}/`);
}

const navLinks = site.headerLinks ?? [];
const extraLinks = [...(site.socialLinks ?? []), ...(site.footerLinks ?? [])];
---

<header
  class="sticky top-0 z-40 w-full border-b border-border/80 bg-background/85 backdrop-blur-md supports-[backdrop-filter]:bg-background/75"
>
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a
      href="/"
      class="group inline-flex min-h-11 items-center gap-2.5 rounded-md text-base font-semibold tracking-tight text-foreground transition-colors hover:text-primary-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline sm:text-lg"
    >
      <span
        aria-hidden="true"
        class="inline-flex size-8 items-center justify-center rounded-lg bg-primary text-xs font-bold tracking-wider text-primary-foreground shadow-xs transition-transform group-hover:scale-105"
      >
        FG
      </span>
      <span>{site.name}</span>
    </a>

    {/* Desktop navigation */}
    <div class="hidden items-center gap-1 md:flex">
      <nav aria-label="Primary" class="flex items-center gap-1">
        {
          navLinks.map((item) => {
            const active = isCurrentRoute(item.url);
            return (
              <a
                href={item.url}
                aria-current={active ? "page" : undefined}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                class:list={[
                  "inline-flex h-10 items-center rounded-md px-3.5 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline",
                  active
                    ? "bg-accent text-accent-foreground"
                    : "text-muted-foreground hover:bg-muted hover:text-foreground",
                ]}
              >
                {item.text}
              </a>
            );
          })
        }
      </nav>

      <div class="ml-2 pl-2 border-l border-border/80">
        <ThemeToggle variant="ghost" size="sm" ariaLabel="Toggle color theme" />
      </div>
    </div>

    {/* Mobile navigation actions */}
    <div class="flex items-center gap-1.5 md:hidden">
      <ThemeToggle variant="ghost" size="md" ariaLabel="Toggle color theme" />

      <Sheet>
        <SheetTrigger asChild>
          <Button variant="outline" size="icon" aria-label="Open navigation menu">
            <Menu2 class="size-5" aria-hidden="true" />
          </Button>
        </SheetTrigger>

        <SheetContent side="right" class="flex flex-col justify-between p-0 sm:max-w-xs">
          <div>
            <SheetHeader class="border-b border-border/80 px-6 py-5 text-left">
              <SheetTitle class="text-base font-semibold tracking-tight">
                {site.name}
              </SheetTitle>
              <SheetDescription class="text-xs text-muted-foreground">
                Software Engineer · Richmond, VA
              </SheetDescription>
            </SheetHeader>

            <nav aria-label="Mobile navigation" class="flex flex-col gap-1.5 p-4">
              <a
                href="/"
                aria-current={isCurrentRoute("/") ? "page" : undefined}
                class:list={[
                  "flex min-h-12 items-center rounded-lg px-4 text-base font-medium transition-colors",
                  isCurrentRoute("/")
                    ? "bg-accent text-accent-foreground"
                    : "text-foreground/85 hover:bg-muted hover:text-foreground",
                ]}
              >
                Home
              </a>

              {
                navLinks.map((item) => {
                  const active = isCurrentRoute(item.url);
                  return (
                    <a
                      href={item.url}
                      aria-current={active ? "page" : undefined}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noopener noreferrer" : undefined}
                      class:list={[
                        "flex min-h-12 items-center rounded-lg px-4 text-base font-medium transition-colors",
                        active
                          ? "bg-accent text-accent-foreground"
                          : "text-foreground/85 hover:bg-muted hover:text-foreground",
                      ]}
                    >
                      {item.text}
                    </a>
                  );
                })
              }
            </nav>
          </div>

          {
            extraLinks.length > 0 && (
              <div class="p-4 pt-0">
                <Separator class="mb-4" />
                <div class="flex flex-wrap gap-2">
                  {extraLinks.map((item) => {
                    const lower = item.text.toLowerCase();
                    return (
                      <Button
                        href={item.url}
                        variant="outline"
                        size="sm"
                        target={item.external ? "_blank" : undefined}
                        rel={item.external ? "noopener noreferrer" : undefined}
                        class="flex-1"
                      >
                        {lower === "github" && <BrandGithub class="size-4" aria-hidden="true" />}
                        {lower === "linkedin" && <BrandLinkedin class="size-4" aria-hidden="true" />}
                        {lower === "rss" && <Rss class="size-4" aria-hidden="true" />}
                        <span>{item.text}</span>
                      </Button>
                    );
                  })}
                </div>
              </div>
            )
          }
        </SheetContent>
      </Sheet>
    </div>
  </div>
</header>
