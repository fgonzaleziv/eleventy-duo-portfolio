---
import { getCollection } from "astro:content";
import HomeLayout from "@/layouts/HomeLayout.astro";

const posts = await getCollection("blog");
posts.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<HomeLayout title="Francisco Gonzalez IV - Software Engineer" posts={posts}>
  <h1>Francisco Gonzalez IV</h1>

  <p>
    Software engineer based in Richmond, VA specialising in enterprise web software and custom web
    solutions for small businesses.
    Through my work, I aim to make a positive impact on the world.
  </p>
</HomeLayout>
